{
  "mcpServers": {
    "styx-vault": {
      "command": "styx-mcp-server",
      "args": [],
      "env": {
        "STYX_BACKEND": "vault",
        "STYX_VAULT_DIR": "${STYX_VAULT_DIR}",
        "STYX_VAULT_CLI": "${STYX_VAULT_CLI}",
        "STYX_VAULT_CHAIN_ID": "${STYX_VAULT_CHAIN_ID}",
        "STYX_VAULT_RPC_URLS": "${STYX_VAULT_RPC_URLS}",
        "STYX_VAULT_ADDRESS": "${STYX_VAULT_ADDRESS}",
        "STYX_VAULT_TOKEN": "${STYX_VAULT_TOKEN}",
        "STYX_VAULT_STATE_ROOT": "${STYX_VAULT_STATE_ROOT}",
        "STYX_VAULT_AGENT_KEY_FILE": "${STYX_VAULT_AGENT_KEY_FILE}"
      }
    }
  }
}
