# Arc testnet configuration for Styx.
# Names only. Copy to .env outside version control and fill in locally.
# Never commit .env files, private keys, keystores or mnemonics, test keys included.
# Chain ID, RPC and token address: see docs/mumbai/BUILD_PLAN.md section 4 and Arc's docs.
#
# ASSUMPTION: these names are proposed. No code reads them yet; the
# styx-vault CLI (BUILD_PLAN.md section 6) will fix the final names.

# Arc chain ID.
STYX_VAULT_CHAIN_ID=

# Comma-separated Arc RPC URLs, in failover order. Some providers embed an API key in the URL.
STYX_VAULT_RPC_URLS=

# Deployed StyxPolicyVault address.
STYX_VAULT_ADDRESS=

# USDC ERC-20 interface address on Arc.
STYX_VAULT_TOKEN=

# Path to the agent key file, kept outside this repo. The agent's environment holds no other key.
STYX_VAULT_AGENT_KEY_FILE=

# Directory for the payment journal, kept outside this repo.
STYX_VAULT_STATE_ROOT=


# Arkiv publisher: path to an owner-only key file holding test GLM only, kept outside this repo.
ARKIV_PUBLISHER_KEY_FILE=
# Arkiv access key from the Arkiv Hub. Optional for fetching.
ARKIV_ACCESS_KEY=

# World gate backend (owner-page/server), only when VITE_WORLD_GATE=1. Never in the agent's environment.
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# The registered HTTPS callback, ending in /api/step-up/callback.
WORLD_REDIRECT_URI=
# The enrolled owner's World subject. The first attempt without it shows the subject to set.
WORLD_OWNER_SUBJECT=
# Optional comma-separated accepted acr values.
WORLD_ACCEPTED_ACR=


# --- scripts/demo.sh reads these from .env at the repo root (git ignores that file). ---
# Only the first six are required. The rest are read from the chain or made on first use.
# The key files named here stay outside the repo. STYX_VAULT_RELAY_TOKEN is a secret: keep it only in your own .env.

# Required. The relay token is the agent token, held by Poulav.
STYX_VAULT_RELAY_TOKEN=
# Required. Two allowed recipients on the vault.
DEMO_VENDOR_A=
DEMO_VENDOR_B=
# (STYX_VAULT_ADDRESS, STYX_VAULT_AGENT_KEY_FILE and the state directory above are also required.
#  Set STYX_VAULT_DIR, or STYX_VAULT_STATE_ROOT, to the state directory.)

# Optional. Defaults: the vault's own token(), owner() and code hash, Arc's public RPC, the hosted relay,
# and issuer and reviewer keys made inside the state directory.
# STYX_VAULT_RELAY_URL=
# DEMO_RPC=
# DEMO_APPROVER=
# STYX_VAULT_CODE_HASH=
# ISSUER_KEY_FILE=
# REVIEWER_KEY_FILE=
# OTHER_REVIEWER_KEY_FILE=
# DEMO_ARKIV_TAG=
# DEMO_ARKIV_WRITER=
