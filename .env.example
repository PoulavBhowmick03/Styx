# Copy to .env (git-ignored) only for values that are not keys you can keep elsewhere. Keys and key
# files never go in the repo. Most settings live in files outside the repo, see docs/near/WALLET_TEST.md:
#   ~/.styx-near/demo.env   the agent's settings for the NEAR vault
#   ~/.styx-near/v2.env     the agent's settings for vault-v2 (Arc and Base through Chain Signatures)
#
# NEAR AI Cloud key for the TEE-attested agent (agent-near-ai, scripts/near/demo_full.sh step 6).
NEARAI_API_KEY=
# Telegram bot token and the approver's chat id, set as secrets on the Fly relay (relay-near), never in git.
TG_TOKEN_ID=
TELEGRAM_CHAT_ID=
