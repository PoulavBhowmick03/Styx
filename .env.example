# Arc testnet configuration for Erebus at ETHGlobal Mumbai.
# Names only. Copy to .env outside version control and fill in locally.
# Never commit .env files, private keys, keystores or mnemonics, test keys included.
# Chain ID, RPC and token address: see docs/mumbai/BUILD_PLAN.md section 4 and Arc's docs.
#
# ASSUMPTION: these names are proposed. No imported code reads them yet; the
# erebus-vault CLI (BUILD_PLAN.md section 6) will fix the final names.

# Arc chain ID.
EREBUS_VAULT_CHAIN_ID=

# Comma-separated Arc RPC URLs, in failover order. Some providers embed an API key in the URL.
EREBUS_VAULT_RPC_URLS=

# Deployed ErebusPolicyVault address.
EREBUS_VAULT_ADDRESS=

# USDC ERC-20 interface address on Arc.
EREBUS_VAULT_TOKEN=

# Path to the agent key file, kept outside this repo. The agent's environment holds no other key.
EREBUS_VAULT_AGENT_KEY_FILE=

# Directory for the payment journal, kept outside this repo.
EREBUS_VAULT_STATE_ROOT=

# Only for the ignored local Anvil tests in sdk/evm/tests. Use the keys anvil prints at startup,
# for accounts 0, 1 and 2. Never use these names for a key that holds real value.
EREBUS_TEST_ANVIL_KEY_0=
EREBUS_TEST_ANVIL_KEY_1=
EREBUS_TEST_ANVIL_KEY_2=
