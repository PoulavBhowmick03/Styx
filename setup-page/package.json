{
  "name": "vault-setup-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-artifact": "node scripts/prepare-artifact.mjs",
    "dev": "npm run prepare-artifact && vite --host 127.0.0.1",
    "build": "npm run prepare-artifact && vite build",
    "typecheck": "tsc --noEmit",
